{
  "name": "trickcord-treat",
  "version": "3.0.0",
  "author": "HeadTriXz",
  "repository": "HeadTriXz/Trickcord-Treat",
  "description": "A Halloween-themed Discord bot that sends virtual trick-or-treaters to your server for a speed-based game.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.9.0" },
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/database/migrate.js",
    "commands:deploy": "tsx --env-file-if-exists=.env scripts/deploy-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
