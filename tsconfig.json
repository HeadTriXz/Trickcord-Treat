{
    "compilerOptions": {
        "declaration": false,
        "esModuleInterop": true,
        "lib": ["ES2023"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "newLine": "lf",
        "noUncheckedIndexedAccess": true,
        "outDir": "dist",
        "resolveJsonModule": true,
        "rootDir": "src",
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2023",
        "verbatimModuleSyntax": true
    },
    "include": ["src"]
}
